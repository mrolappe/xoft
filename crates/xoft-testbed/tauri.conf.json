{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xoft-testbed",
  "version": "0.1.0",
  "identifier": "dev.xoft.testbed",
  "build": {
    "frontendDist": "../../testbed-ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../testbed-ui"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../testbed-ui"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "xoft testbed",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
